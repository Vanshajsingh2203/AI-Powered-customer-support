APP_NAME=Customer Support AI
DEBUG=True

# Required. Generate a secure secret.
JWT_SECRET_KEY=replace_me_with_a_generated_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@localhost:5432/customer_support_db

# Must be a separate database from DATABASE_URL.
TEST_DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@localhost:5432/customer_support_test_db